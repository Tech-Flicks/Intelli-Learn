# Intelli-Learn: settings for Docker Compose.
#
# Copy this file to ".env" (same folder as docker-compose.yml) and edit it.
# ".env" is ignored by git and never copied into an image.
# Every value is optional unless it says "required".
#
# The web app itself needs no settings here: a parent configures it in the
# browser. Never put a secret in a variable whose name starts with VITE_,
# because such variables are built into the public JavaScript.

# ---------------------------------------------------------------------------
# Web app (service "web")
# ---------------------------------------------------------------------------

# Port on this computer where the app is served over plain HTTP.
WEB_PORT=8080

# Network interface for that port. 0.0.0.0 = reachable from the whole network.
# Set 127.0.0.1 to allow this computer only (sensible when Caddy below serves
# everyone else over HTTPS).
WEB_BIND=0.0.0.0

# Profiles to start without typing --profile each time.
# Empty = web only. Examples: proxy | https | proxy,https
COMPOSE_PROFILES=

# ---------------------------------------------------------------------------
# AI proxy (service "ai-proxy", profile "proxy")
# Keeps the API key on the server. In the app choose AI mode "Proxy".
# ---------------------------------------------------------------------------

# Required for the proxy. Base URL of an OpenAI-compatible API, without a
# trailing slash. Examples:
#   https://api.openai.com/v1
#   http://host.docker.internal:11434/v1   (Ollama on this computer)
#   http://host.docker.internal:1234/v1    (LM Studio on this computer)
UPSTREAM_BASE_URL=https://api.openai.com/v1

# API key the proxy adds to every forwarded request. Leave empty for local
# model servers that need no key. Set a monthly spending limit on the
# provider's website for this key.
UPSTREAM_API_KEY=

# Comma-separated list of model names the proxy will forward. Requests for any
# other model are refused. Empty = any model. Must contain the models chosen in
# the app's AI settings (chat model, image model if used, and the moderation
# model "omni-moderation-latest" when you list models for OpenAI).
ALLOWED_MODELS=

# Requests per minute allowed from one device (by IP address). 0 = no limit.
RATE_LIMIT_PER_MINUTE=60

# Extra browser origins that may call the proxy, comma-separated, e.g.
# https://learn.example.com. Normally empty: requests from the app's own
# address are always accepted, requests from other websites are refused.
ALLOWED_ORIGINS=

# How many reverse proxies in front of the AI proxy are believed when it looks
# for the device address (for the rate limit). Leave this at 1 in every setup:
# nginx in the web container works out the device address itself, also behind
# Caddy (profile "https"), and passes on that one value. A higher number makes
# the proxy believe an address that the device can make up, which lets it get
# around the rate limit.
TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# HTTPS (service "caddy", profile "https")
# ---------------------------------------------------------------------------

# The one address people type to open the app, without "https://" and without
# a port. Examples: learn.example.com | learn.home.arpa | 192.168.1.50 | localhost
SITE_ADDRESS=localhost

# Where the certificate comes from:
#   internal          Caddy's own certificate authority. For home networks.
#                     Each device must trust Caddy's root certificate once
#                     (docs/HOSTING.md explains how).
#   you@example.com   Your email address. For a public domain that points at
#                     this server: Caddy gets a free Let's Encrypt certificate.
CADDY_TLS=internal

# Ports on this computer for Caddy. Keep 80 and 443 unless they are taken.
HTTP_PORT=80
HTTPS_PORT=443
